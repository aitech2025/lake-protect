# Copy to .env and fill in. Never commit .env.
# PowerShell: py -c "import secrets;print(secrets.token_urlsafe(48))"  generates a value.

LP_DB_USER=lakeprotect
LP_DB_PASSWORD=change-me
LP_DB_NAME=lakeprotect

# Bounded API connection pool. Tune from measured concurrent DB workloads.
LP_DB_POOL_SIZE=10
LP_DB_MAX_OVERFLOW=20
LP_DB_POOL_TIMEOUT_SECONDS=30
LP_DB_POOL_RECYCLE_SECONDS=1800
LP_DB_STATEMENT_TIMEOUT_MS=60000
LP_DB_PORT=5544
LP_API_PORT=8100
LP_WEB_PORT=8180

# Signs demo login tokens.
LP_JWT_SECRET=change-me

# Shared secret the pipeline sends to POST /candidates. Leave empty to switch ingest off.
LP_PIPELINE_TOKEN=change-me

# Imagery cache for the pipeline. Must be outside OneDrive (CONTEXT.md section 11).
LP_CACHE_DIR=C:\lp-cache

# Sentinel-1 access for M3 (not needed until then). See DECISIONS.md when M3 starts.
# LP_CDSE_S3_ACCESS_KEY=
# LP_CDSE_S3_SECRET_KEY=

# Production: use a dedicated non-superuser, non-BYPASSRLS API DB role.
# Do not use the migration owner or a PostgreSQL superuser as the API runtime identity.
