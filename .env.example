# Copy to .env and fill in. Never commit .env.
# PowerShell: py -c "import secrets;print(secrets.token_urlsafe(48))"  generates a value.

LP_DB_USER=lakeprotect
LP_DB_PASSWORD=change-me
LP_DB_NAME=lakeprotect
LP_DB_PORT=5544
LP_API_PORT=8100
LP_WEB_PORT=8180

# Signs demo login tokens.
LP_JWT_SECRET=change-me

# Shared secret the pipeline sends to POST /candidates. Leave empty to switch ingest off.
LP_PIPELINE_TOKEN=change-me

# Notifications (DECISIONS.md D-059). The desk's address, used for links in emails and messages.
LP_PUBLIC_URL=http://localhost:8180
# file: each email is written to the outbox folder in storage and nothing leaves the machine.
# smtp: send through the State's mail relay (set the LP_SMTP_ values). off: no email.
LP_EMAIL_TRANSPORT=file
# LP_SMTP_HOST=
# LP_SMTP_PORT=587
# LP_SMTP_USER=
# LP_SMTP_PASSWORD=
# SMS and WhatsApp gateway credentials, once the State has an agreement (api/app/notify/channels.yaml).
# LP_SMS_TOKEN=
# LP_WHATSAPP_TOKEN=
# Citizen reports by WhatsApp (D-062): the app secret that signs incoming messages, and the token the
# webhook answers during verification. Without the secret, the webhook refuses every message.
# LP_WHATSAPP_APP_SECRET=
# LP_WHATSAPP_VERIFY_TOKEN=

# Imagery cache for the pipeline. Must be outside OneDrive (CONTEXT.md section 11).
LP_CACHE_DIR=C:\lp-cache

# Sentinel-1 access for M3 (not needed until then). See DECISIONS.md when M3 starts.
# LP_CDSE_S3_ACCESS_KEY=
# LP_CDSE_S3_SECRET_KEY=
